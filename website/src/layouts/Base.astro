---
import Analytics from '@vercel/analytics/astro';
import '../styles/theme.css';
import '../styles/kit.css';
import { SAME_MAKER, SITE } from '../data/site';
import { absoluteUrl } from '../lib/content';

interface Props {
  title: string;
  description: string;
  path: string;
  ogType?: 'website' | 'article';
  jsonLd?: Record<string, unknown>[];
  publishedTime?: string;
  modifiedTime?: string;
  noindex?: boolean;
  nav?: 'blog' | 'tools' | null;
}

const { title, description, path, ogType = 'website', jsonLd = [], publishedTime, modifiedTime, noindex = false, nav = null } =
  Astro.props;
const canonical = absoluteUrl(path);
const ogImage = absoluteUrl(SITE.ogImage);
const robots = noindex
  ? 'noindex, follow'
  : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1';
const json = (d: unknown) => JSON.stringify(d).replace(/</g, '\\u003c');
---

<!doctype html>
<html lang={SITE.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <meta name="author" content={SITE.author.name} />
    <link rel="canonical" href={canonical} />
    {SITE.googleSiteVerification && <meta name="google-site-verification" content={SITE.googleSiteVerification} />}
    <link rel="icon" href={SITE.favicon} type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
    <link rel="alternate" type="text/markdown" href="/llms.txt" title="LLM summary" />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content={SITE.ogLocale} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href={SITE.fontsHref} />
    {jsonLd.map((d) => <script is:inline type="application/ld+json" set:html={json(d)} />)}
    {
      SITE.gaId && (
        <>
          <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${SITE.gaId}`} />
          <script is:inline define:vars={{ gaId: SITE.gaId }}>
            window.dataLayer = window.dataLayer || [];
            function gtag() { dataLayer.push(arguments); }
            gtag('js', new Date());
            gtag('config', gaId);
          </script>
        </>
      )
    }
  </head>
  <body>
    <Analytics />
    <a class="skip" href="#main">Skip to content</a>
    <header class="top">
      <div class="top-inner">
        <a class="brand" href="/" aria-label="Windowmac home">
          <img src={SITE.favicon} alt="" width="28" height="28" />
          <span>Windowmac</span>
        </a>
        <nav aria-label="Sections">
          <span class="nav-pill" aria-hidden="true"></span>
          <a href="/#how">How it works</a>
          <a href="/#strip">Strip</a>
          <a href="/#layouts">Layouts</a>
          <a href="/#keys">Shortcuts</a>
          <a href="/#install">Install</a>
          <a href="/#faq">FAQ</a>
          <a href="/blog/" class:list={{ on: nav === 'blog' }} aria-current={nav === 'blog' ? 'page' : undefined}>Guides</a>
        </nav>
        <a class="gh-star" href={SITE.repoUrl} target="_blank" rel="noopener noreferrer" aria-label="Star Windowmac on GitHub">
          <span class="gh-glow" aria-hidden="true"><span class="liquid"><i></i><i></i><i></i><i></i><i></i></span></span>
          <span class="gh-body" aria-hidden="true"><span class="liquid"><i></i><i></i><i></i><i></i><i></i></span><span class="gh-shine"></span></span>
          <span class="gh-label">
            <svg viewBox="0 0 16 16" width="18" height="18" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"></path></svg>
            <span class="gh-text">GitHub</span>
          </span>
        </a>
        <a class="button small" href={SITE.installHref}>Install</a>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="k-foot">
      <div class="wrap">
        <section class="k-foot-cta" aria-label={`Get ${SITE.name}`}>
          <div class="k-foot-cta-copy">
            <p class="k-foot-eyebrow">Free · Open source · No account</p>
            <p class="k-foot-title">Every window, <em>right where you flick it.</em></p>
            <p class="k-foot-hint">Hold <kbd>⌥</kbd> and flick toward a half, third or quarter. Let go. Done.</p>
            <div class="k-foot-actions">
              <a class="k-btn" href={SITE.installHref}>{SITE.ctaLabel}</a>
              <a class="k-btn ghost" href={SITE.repoUrl}>★ Star on GitHub</a>
            </div>
          </div>
          <div class="k-foot-demo" aria-hidden="true">
            <div class="k-foot-screen">
              <span class="k-foot-bar"><i></i><i></i><i></i></span>
              <span class="k-foot-pane"></span>
              <span class="k-foot-cursor"></span>
            </div>
          </div>
        </section>

        <div class="k-foot-grid">
          <div class="k-foot-brand">
            <a class="k-brand" href="/"><img src={SITE.favicon} alt="" width="28" height="28" />{SITE.name}</a>
            <p>{SITE.tagline}. A tiny window manager for macOS 13 and later.</p>
          </div>
          <nav aria-label="Product">
            <h2>Product</h2>
            <ul>
              <li><a href="/">Home</a></li>
              <li><a href={SITE.installHref}>Install</a></li>
              <li><a href="/#faq">FAQ</a></li>
              <li><a href={SITE.repoUrl}>{SITE.repoLabel}</a></li>
            </ul>
          </nav>
          <nav aria-label="Learn">
            <h2>Learn</h2>
            <ul>
              <li><a href="/blog/">All guides</a></li>
              <li><a href="/tools/">Free tools and quizzes</a></li>
              <li><a href="/llms.txt">llms.txt</a></li>
            </ul>
          </nav>
          <div class="k-foot-apps">
            <h2>From the same maker</h2>
            <ul>
              {
                SAME_MAKER.map((a) => (
                  <li>
                    <a class="k-foot-app" href={a.url}>
                      <img src={a.icon} alt="" width="36" height="36" loading="lazy" />
                      <span>
                        <strong>{a.name}</strong>
                        <small>{a.pitch}</small>
                      </span>
                    </a>
                  </li>
                ))
              }
            </ul>
          </div>
        </div>

        <div class="k-foot-base">
          <p>Made with ♥ in Nepal by <a href={SITE.author.url}>{SITE.author.name}</a>. MIT license.</p>
          <a class="k-foot-top" href="#main">Back to top ↑</a>
        </div>
      </div>
    </footer>
    <script is:inline>
      (() => {
        const top = document.querySelector('.top');
        const nav = top && top.querySelector('nav');
        const pill = nav && nav.querySelector('.nav-pill');
        const links = nav ? [...nav.querySelectorAll('a')] : [];
        const current = nav && nav.querySelector('a.on, a[aria-current="page"]');
        const move = (a) => {
          if (!pill) return;
          if (!a) { pill.style.opacity = '0'; return; }
          pill.style.left = a.offsetLeft + 'px';
          pill.style.width = a.offsetWidth + 'px';
          pill.style.opacity = '1';
        };
        links.forEach((a) => {
          a.addEventListener('mouseenter', () => move(a));
          a.addEventListener('focus', () => move(a));
        });
        if (nav) nav.addEventListener('mouseleave', () => move(current));
        const onScroll = () => top && top.classList.toggle('scrolled', scrollY > 8);
        addEventListener('scroll', onScroll, { passive: true });
        addEventListener('resize', () => move(current));
        onScroll();
        move(current);
      })();
    </script>
  </body>
</html>
