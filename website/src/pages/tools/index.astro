---
import AppsCallout from '../../components/AppsCallout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { publishedQuizzes, quizPath } from '../../data/quizzes';
import { SITE } from '../../data/site';
import { publishedTools, toolPath } from '../../data/tools';
import Base from '../../layouts/Base.astro';
import { breadcrumbJsonLd, itemListJsonLd } from '../../lib/jsonld';
import '../../styles/hub.css';

const tools = publishedTools();
const quizzes = publishedQuizzes();
const crumbs = [{ name: 'Home', path: '/' }, { name: 'Free tools', path: '/tools/' }];
const items = [
  ...tools.map((t) => ({ name: t.name, path: toolPath(t.slug) })),
  ...quizzes.map((q) => ({ name: q.name, path: quizPath(q.slug) })),
];

// One glyph per kind of tool, read from the slug so new tools pick one up automatically.
type Kind = 'sheet' | 'calc' | 'check' | 'plan' | 'train';
const kindOf = (slug: string): Kind =>
  /cheat-sheet|shortcuts/.test(slug) ? 'sheet'
  : /calculator/.test(slug) ? 'calc'
  : /checker/.test(slug) ? 'check'
  : /trainer/.test(slug) ? 'train'
  : 'plan';
const kindLabel: Record<Kind, string> = { sheet: 'Cheat sheet', calc: 'Calculator', check: 'Checker', plan: 'Planner', train: 'Trainer' };
const glyph: Record<Kind, string> = {
  sheet: '<rect x="3" y="5" width="18" height="14" rx="2.5"/><path d="M7 9h2M11 9h2M15 9h2M7 13h10M7 16h6"/>',
  calc: '<rect x="5" y="3" width="14" height="18" rx="2.5"/><path d="M8 7h8M8.5 12h1M12 12h0M14.5 12h1M8.5 16h1M14.5 16h1M12 15v2"/>',
  check: '<path d="M12 3 4.5 6v5.5c0 4.6 3.2 8.2 7.5 9.5 4.3-1.3 7.5-4.9 7.5-9.5V6z"/><path d="m8.5 12 2.5 2.5 4.5-5"/>',
  plan: '<rect x="3" y="4" width="8" height="7" rx="1.5"/><rect x="13" y="4" width="8" height="16" rx="1.5"/><rect x="3" y="13" width="8" height="7" rx="1.5"/>',
  train: '<rect x="3" y="7" width="18" height="11" rx="2.5"/><path d="M7 11h.01M11 11h.01M15 11h.01M8 14.5h8"/>',
};
---
<Base title={`Free Mac Tools and Quizzes | ${SITE.name}`}
  description={`Free browser tools and quizzes from ${SITE.name}. Calculators, cheat sheets and quizzes for Mac users. Nothing to install, nothing uploaded.`}
  path="/tools/" nav="tools" jsonLd={[breadcrumbJsonLd(crumbs), itemListJsonLd('Free tools', items)]}>
  <div class="wrap hub">
    <header class="hub-head">
      <Breadcrumbs crumbs={crumbs} />
      <div class="hub-head-row">
        <div>
          <p class="hub-kicker"><span></span>Free tools from {SITE.name}</p>
          <h1 class="hub-title">Small tools, <em>straight answers.</em></h1>
          <p class="hub-lede">Calculators, cheat sheets, checkers and quizzes that run right here in your browser. Nothing to install, no sign-up, and nothing you type leaves your device.</p>
        </div>
        <dl class="hub-stats">
          <div><dt>Tools</dt><dd>{tools.length}</dd></div>
          <div><dt>Quizzes</dt><dd>{quizzes.length}</dd></div>
          <div><dt>Price</dt><dd>$0</dd></div>
        </dl>
      </div>
    </header>

    <section aria-labelledby="tools-h">
      <h2 id="tools-h" class="hub-label">Tools</h2>
      <div class="hub-bento">
        {tools.map((t, i) => {
          const k = kindOf(t.slug);
          return (
            <a class={`hub-tool${i === 0 ? ' wide' : ''}`} href={toolPath(t.slug)} data-kind={k}>
              <span class="hub-tool-top">
                <span class="hub-glyph"><svg viewBox="0 0 24 24" aria-hidden="true" set:html={glyph[k]} /></span>
                <span class="hub-n">{String(i + 1).padStart(2, '0')}</span>
              </span>
              <span class="hub-badge">{kindLabel[k]}</span>
              <h3>{t.name}</h3>
              <p>{t.card}</p>
              <span class="hub-open">Open tool <i aria-hidden="true">→</i></span>
            </a>
          );
        })}
      </div>
    </section>

    {quizzes.length > 0 && (
      <section class="hub-quizzes" aria-labelledby="quiz-h">
        <h2 id="quiz-h" class="hub-label">Quizzes</h2>
        <div class="hub-quiz-grid">
          {quizzes.map((q) => (
            <a class="hub-quiz" href={quizPath(q.slug)}>
              <span class="hub-quiz-q" aria-hidden="true">?</span>
              <div class="hub-quiz-body">
                <span class="hub-badge">Quiz · {q.questions.length} questions</span>
                <h3>{q.name}</h3>
                <p>{q.card}</p>
              </div>
              <span class="hub-quiz-go" aria-hidden="true">Start →</span>
            </a>
          ))}
        </div>
      </section>
    )}
    <AppsCallout primary={SITE.key} />
  </div>
</Base>
